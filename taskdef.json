{

    "containerDefinitions": [
        {
            "name": "products",
            "image": "<IMAGE1_NAME>",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "name": "products-3000-tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "ALLOWED_ORIGINS",
                    "value": "http://localhost:5173"
                },
                {
                    "name": "ENABLE_XRAY",
                    "value": "true"
                },
                {
                    "name": "DB_SSL",
                    "value": "true"
                },
                {
                    "name": "PORT",
                    "value": "3000"
                },
                {
                    "name": "DB_PORT",
                    "value": "5432"
                },
                {
                    "name": "DB_USER",
                    "value": "postgres"
                },
                {
                    "name": "ENV",
                    "value": "production"
                },
                {
                    "name": "DB_HOST",
                    "value": "ecomm-postgres-db.cl2q8asoazlq.ap-southeast-2.rds.amazonaws.com"
                },
                {
                    "name": "LOG_LEVEL",
                    "value": "info"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        }
    ],
    "family": "products-service",
    "taskRoleArn": "arn:aws:iam::206818123390:role/ecomm-ecs-task-role",
    "executionRoleArn": "arn:aws:iam::206818123390:role/ecomm-ecs-execution-role",
    "networkMode": "awsvpc",

    "volumes": [],


    "placementConstraints": [],

    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}