# Orders Service — environment variables
# Copy to .env for local dev. Never commit .env to git.

ENV=development
PORT=8000
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false

# Products service URL (internal ALB path in AWS)
PRODUCTS_SERVICE_URL=http://localhost:3000

# X-Ray
ENABLE_XRAY=false

# CORS
ALLOWED_ORIGINS=http://localhost:5173
