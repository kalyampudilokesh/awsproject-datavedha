# Products Service — environment variables
# Copy this to .env for local development. Never commit .env to git.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (set via Secrets Manager in AWS; use local values for dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false

# X-Ray tracing (set to true on ECS)
ENABLE_XRAY=false

# CORS
ALLOWED_ORIGIN=http://localhost:5173
